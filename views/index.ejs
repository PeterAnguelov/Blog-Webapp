<%- include("partials/header.ejs") %>

<div class="center-content">
    <h2 class="intro"> Hi everyone. Welcome to my blog website.<br>This is a test so it might look a bit shit </h2>

    <ul class="post-list">
        <% posts.forEach(post => { %>
        <li class="post-item">
            <a href="/post/<%= post.slug %>" class="post-item-link"><%= post.title %></a>
            <p class="post-item-excerpt"><%= post.excerpt %></p>
        </li>
        <% }); %>
    </ul>

</div>

<%- include("partials/footer.ejs") %>