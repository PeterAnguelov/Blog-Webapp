<%- include("partials/header.ejs") %>

<div class="post-page">
    <!-- Side Panel -->
    <div class="post-side-panel">
        <h1 class="post-side-title">Post List</h1>

        <!-- Generates all the posts in sidebar -->
        <ul class="side-list">
            <% posts.forEach(p => { %>
            <li class="side-item <%= p.id === post.id ? 'side-item-selected' : ''%>">
                <a href="/post/<%= p.slug %>" class="side-item-link">
                    <div class="side-item-title"><%= p.title %></div>
                </a>
            </li>
            <% }); %>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="post-content">
        <!-- Post Title Area -->
        <div class="post-title-area">
            <!-- This will choose whether previous button is enabled or disabled -->
            <% if (post.id > 1) {%>
                <a href="/post/<%= previousPost.slug %>" class="previous-next-button hover-button">Previous Post</a>
            <% } else {%>
                <p class="previous-next-button grayed-button">Previous Post</p>
            <% } %>

            <h1 class="post-item-title"><%= post.title %></h1>

            <!-- This will choose whether next button is enabled or disabled -->
            <% if (post.id < posts.length) {%>
                <a href="/post/<%= nextPost.slug %>" class="previous-next-button hover-button">Next Post</a>
            <% } else {%>
                <p class="previous-next-button grayed-button">Next Post</p>
            <% } %>
        </div>

        <!-- Date -->
        <p class="post-item-date"><%= post.date %></p>

        <!-- Post Content -->
        <div class="post-item-content">
            <p><%= post.content %></p>
        </div>

        <div class="below-content">
            <!-- Delete Post Button -->
            <form action="/post/<%= post.slug %>/delete" method="POST">
                <button type="submit" class="delete-button">Delete Post</button>
            </form>

            <a href="/edit-post/<%= post.slug %>" class="edit-button">Edit Post</a>
        </div>
        
    </div>
</div>

<%- include("partials/footer.ejs") %>