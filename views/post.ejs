<%- include("partials/header.ejs") %>

<div class="post-page">
    <!-- Side Panel -->
    <div class="post-side-panel">
        <h1>Post List</h1>

        <!-- Generates all the posts in sidebar -->
        <ul class="side-list">
            <% posts.forEach(post => { %>
            <li class="side-item">
                <a href="/post/<%= post.slug %>" class="side-item-link">
                    <div class="side-item-title"><%= post.title %></div>
                </a>
            </li>
            <% }); %>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="post-content">
        <!-- Post Title Area -->
        <div class="post-title-area">
            <% console.log(post.id); %> <!-- This is a placeholder -->

            <!-- This will choose whether previous button is enabled or disabled -->
            <% if (post.id > 1) {%>
                <a href="/post/<%= previousPost.slug %>" class="previous-next-button hover-button">Previous Post</a>
            <% } else {%>
                <p class="previous-next-button grayed-button">Previous Post</p>
            <% } %>

            <h1 class="post-item-title"><%= post.title %></h1>

            <!-- This will choose whether next button is enabled or disabled -->
            <% if (post.id < posts.length) {%>
                <a href="/post/<%= nextPost.slug %>" class="previous-next-button hover-button">Next Post</a>
            <% } else {%>
                <p class="previous-next-button grayed-button">Next Post</p>
            <% } %>
        </div>

        <!-- Date -->
        <p class="post-item-date"><%= post.date %></p>

        <div class="post-item-content">
            <!-- Post Content -->
            <p><%= post.content %></p>
        </div>
        
    </div>
</div>

<%- include("partials/footer.ejs") %>